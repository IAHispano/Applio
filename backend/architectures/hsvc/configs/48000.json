{
  "architecture": "hsvc",
  "version": "v1-compact",
  "model": {
    "sample_rate": 48000,
    "hop_in": 480,
    "hop_dec": 240,
    "win_dec": 960,
    "n_fft_dec": 2048,
    "n_erb_bands": 256,
    "erb_2d_bins": 128,
    "num_speakers": 128,
    "content_dim": 768,
    "bottleneck_dim": 256,
    "hidden_dim": 384,
    "spk_dim": 256,
    "num_protos": 16,
    "n_enc_layers": 6,
    "n_dec_1d_layers": 4,
    "n_spec_2d_layers": 3,
    "spec_2d_channels": 56,
    "silence_thresh_db": -64.0,
    "silence_slope_db": 3.0,
    "nyquist_ratio": 0.99,
    "use_spec_res": false
  },
  "train": {
    "seed": 1234,
    "learning_rate": 3e-4,
    "disc_learning_rate": 2.1e-4,
    "finetune_timbre_lr": 6e-4,
    "finetune_backbone_lr": 1e-4,
    "betas": [0.8, 0.99],
    "weight_decay": 1e-4,
    "batch_size": 8,
    "crop_frames": 80,
    "disc_frames": 40,
    "adv_warmup_steps": 1000,
    "swap_start_steps": 3000,
    "swap_every": 2,
    "grl_weight": 0.12,
    "ema_decay": 0.999,
    "silence_aug_prob": 0.18,
    "gain_aug_db": 3.0
  }
}
