{
  "data": {
    "sample_rate": 44100,
    "hop_length": 512,
    "n_fft": 2048,
    "win_length": 2048,
    "n_mels": 128,
    "mel_fmin": 40.0,
    "mel_fmax": 16000.0,
    "mel_mean": -5.0,
    "mel_std": 2.5,
    "content_interpolation": "linear"
  },
  "flow": {
    "seed": 1234,
    "optimizer": "muon",
    "learning_rate": 3e-4,
    "finetune_learning_rate": 1e-4,
    "lr_final_ratio": 0.1,
    "betas": [0.9, 0.99],
    "weight_decay": 0.1,
    "warmup_steps": 2000,
    "segment_frames": 400,
    "grad_clip": 1.0,
    "ema_decay": 0.9999,
    "finetune_ema_decay": 0.999,
    "speaker_dropout": 0.1,
    "tension_dropout": 0.1,
    "finetune_freeze_voice": true,
    "key_shift_range": 5.0,
    "key_shift_prob": 0.43,
    "time_stretch_range": [0.5, 2.0],
    "time_stretch_prob": 0.43,
    "aux_mel_weight": 0.2,
    "mean_flow_ratio": 0.25,
    "mean_flow_warmup_steps": 10000,
    "eval_interval": 1000,
    "holdout_clips": 32,
    "num_workers": 8,
    "model": {
      "content_channels": 768,
      "hidden_channels": 384,
      "encoder_layers": 4,
      "content_bottleneck": 0,
      "content_bottleneck_noise": 0.0,
      "speaker_channels": 256,
      "pitch_fourier": 6,
      "harmonic_prior": true,
      "breathiness": true,
      "key_shift": true,
      "speed": true,
      "tension": true,
      "dual_timestep": true,
      "time_sampling": "uniform",
      "backbone": "lynxnet2",
      "backbone_args": {"channels": 1024, "layers": 6, "expansion": 1, "kernel_size": 31, "adaln": true},
      "aux_decoder": {"channels": 512, "layers": 6, "dropout": 0.1, "speaker": true},
      "t_start": 0.4,
      "aux_grad": 0.1
    }
  }
}
